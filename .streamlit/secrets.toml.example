# Groq API key for all AI text generation, quizzes, and summaries (required)
GROQ_API_KEY = "gsk_your_key_here"

# Tavily API key for live syllabus and exam web search Q&A (optional)
TAVILY_API_KEY = "tvly-your_key_here"

# Tavily search depth: "basic" or "advanced" (optional, default: "basic")
TAVILY_DEPTH = "basic"

# Soft prompt limit per session before showing quota warning (optional, default: "25")
MAX_PROMPTS_PER_SESSION = "25"

# Comma-separated allowed hostnames for pdfUrl SSRF prevention (optional, empty allows all)
ALLOWED_PDF_HOSTS = ""

# Comma-separated Groq model chain for fallback (optional, default: "openai/gpt-oss-120b,openai/gpt-oss-20b")
GROQ_MODEL_CHAIN = ""

# Model ID used for question topic tagging (optional, default: "openai/gpt-oss-20b")
TAGGING_MODEL = "openai/gpt-oss-20b"

# Maximum question-tagging LLM calls per calendar day (optional, default: "40")
TAGGING_DAILY_BUDGET = "40"

# Maximum untagged papers to process in a single button click (optional, default: "3")
TAG_MAX_PER_CLICK = "3"
